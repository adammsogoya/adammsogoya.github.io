<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adam Malcous Msogoya - Personal Portfolio</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            line-height: 1.6;
            padding: 40px 20px;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            border-bottom: 1px solid #334155;
            padding-bottom: 20px;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: bold;
            color: #38bdf8;
        }

        .nav-links a {
            color: #94a3b8;
            text-decoration: none;
            margin-left: 20px;
            font-size: 0.95rem;
            font-weight: 500;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: #38bdf8;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 40px;
            margin-bottom: 40px;
            text-align: center;
        }

        .hero h1 {
            font-size: 2.2rem;
            color: #f8fafc;
            margin-bottom: 10px;
        }

        .hero p.subtitle {
            font-size: 1.1rem;
            color: #38bdf8;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .hero p.bio {
            color: #cbd5e1;
            font-size: 1rem;
            max-width: 700px;
            margin: 0 auto 25px auto;
        }

        .btn {
            display: inline-block;
            background-color: #0284c7;
            color: #ffffff;
            padding: 10px 22px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            margin: 0 5px;
            transition: background 0.2s;
        }

        .btn:hover {
            background-color: #0369a1;
        }

        .btn-outline {
            background-color: transparent;
            border: 1px solid #0284c7;
            color: #38bdf8;
        }

        .btn-outline:hover {
            background-color: rgba(2, 132, 199, 0.1);
        }

        /* Section Styling */
        .section-title {
            font-size: 1.5rem;
            color: #f8fafc;
            margin-bottom: 20px;
            border-left: 4px solid #0284c7;
            padding-left: 12px;
        }

        /* Card Grid Layout */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .card {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 24px;
        }

        .card-category {
            font-size: 0.8rem;
            text-transform: uppercase;
            color: #94a3b8;
            font-weight: 600;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        .card-title {
            font-size: 1.15rem;
            font-weight: bold;
            color: #38bdf8;
            margin-bottom: 10px;
        }

        .card-text {
            color: #cbd5e1;
            font-size: 0.92rem;
            margin-bottom: 16px;
        }

        .tags {
            margin-top: 10px;
        }

        .tag {
            display: inline-block;
            background-color: #0f172a;
            color: #7dd3fc;
            border: 1px solid #0284c7;
            font-size: 0.75rem;
            padding: 3px 8px;
            border-radius: 12px;
            margin-right: 5px;
            margin-bottom: 5px;
        }

        /* Skills List */
        .skills-container {
            background-color: #1e293b;
            border: 1px solid #334155;
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 40px;
        }

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .skill-group h3 {
            font-size: 1rem;
            color: #38bdf8;
            margin-bottom: 10px;
            border-bottom: 1px dashed #334155;
            padding-bottom: 6px;
        }

        .skill-group ul {
            list-style: none;
            padding: 0;
        }

        .skill-group li {
            color: #cbd5e1;
            font-size: 0.9rem;
            margin-bottom: 6px;
        }

        /* Footer */
        footer {
            text-align: center;
            border-top: 1px solid #334155;
            padding-top: 25px;
            color: #64748b;
            font-size: 0.9rem;
        }
    </style>
</head>
